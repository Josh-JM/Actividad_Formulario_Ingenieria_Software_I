# Configuración de Base de Datos SQLite (acepta 'database.db' o 'sqlite:///database.db')
DATABASE_PATH=database.db

# Secret key para las sesiones de Flask
FLASK_SECRET_KEY=dev-super-secret-key-change-this-in-production

# =====================================================================
# CONFIGURACIÓN DEL SERVIDOR DE CORREOS (SMTP)
# =====================================================================
# Servidor SMTP (Ej: smtp.gmail.com, sandbox.smtp.mailtrap.io, smtp.office365.com)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Credenciales de acceso
SMTP_USERNAME=tu_correo@gmail.com
# Para Gmail: Genera una "Contraseña de Aplicación" en Seguridad de tu cuenta Google
SMTP_PASSWORD=tu_contraseña_de_aplicacion_o_token

# Identidad del remitente
SMTP_SENDER_NAME=Sistema de Registro
SMTP_SENDER_EMAIL=tu_correo@gmail.com
