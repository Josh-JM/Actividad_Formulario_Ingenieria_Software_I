# Configuración de Supabase
# Reemplaza los valores de ejemplo con tus credenciales de Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public key)

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Secret key para las sesiones de Flask
FLASK_SECRET_KEY=dev-super-secret-key-change-this-in-production
